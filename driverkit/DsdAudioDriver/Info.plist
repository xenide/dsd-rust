<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>DsdAudioDriver</string>
	<key>CFBundleIdentifier</key>
	<string>com.github.xenide.dsdrust.driver</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>DsdAudioDriver</string>
	<key>CFBundlePackageType</key>
	<string>DEXT</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>OSBundleUsageDescription</key>
	<string>Plays DSD to a USB DAC without going through the system USB audio daemon.</string>
	<key>OSMinimumDriverKitVersion</key>
	<string>21.0</string>
	<key>IOKitPersonalities</key>
	<dict>
		<key>DsdAudioDriver</key>
		<dict>
			<key>CFBundleIdentifier</key>
			<string>com.github.xenide.dsdrust.driver</string>
			<key>CFBundleIdentifierKernel</key>
			<string>com.apple.kpi.iokit</string>
			<key>IOClass</key>
			<string>IOUserService</string>
			<key>IOUserClass</key>
			<string>DsdAudioDriver</string>
			<key>IOUserServerName</key>
			<string>com.github.xenide.dsdrust.driver</string>
			<key>IOProviderClass</key>
			<string>IOUSBHostInterface</string>
			<key>IOMatchCategory</key>
			<string>com.github.xenide.dsdrust.driver</string>
			<!-- Keyed to one DAC on purpose. Matching every UAC2 streaming interface would
			     take usbaudiod's place for every USB audio device on the machine, which is
			     not what anyone installing this asked for. Fill both in from
			     `dsd-rust devices` or `ioreg -p IOUSB -l`, in decimal. -->
			<key>idVendor</key>
			<integer>11655</integer>
			<key>idProduct</key>
			<integer>49154</integer>
			<key>bInterfaceClass</key>
			<integer>1</integer>
			<key>bInterfaceSubClass</key>
			<integer>2</integer>
			<!-- Above usbaudiod, which is what wins the interface today. -->
			<key>IOProbeScore</key>
			<integer>100000</integer>
			<key>IOUserAudioDriverUserClientProperties</key>
			<dict>
				<key>IOClass</key>
				<string>IOUserUserClient</string>
				<key>IOUserClass</key>
				<string>IOUserAudioDriverUserClient</string>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
